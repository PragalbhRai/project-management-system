{
  "name": "@pms/api-client",
  "version": "1.0.0",
  "private": true,
  "description": "Shared TypeScript API client generated from Swagger/OpenAPI specification",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "generate": "openapi-typescript ./openapi.json -o ./src/schema.ts"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.8.2"
  }
}
