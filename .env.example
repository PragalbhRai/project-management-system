# ==============================================================================
# Project Management System - Environment Variables Configuration
# ==============================================================================

# Database connection URL (PostgreSQL)
# Format: postgresql://<username>:<password>@<host>:<port>/<database>?schema=<schema>
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5433/pms_dev?schema=public

# JWT Secret for access token signing (at least 32 characters in production)
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long

# JWT Expiration time string (e.g., 15m, 1h, 1d)
JWT_EXPIRES_IN=1d

# CORS Allowed Origins (comma-separated list of allowed origins, whitespace trimmed)
# Example: http://localhost:5173,http://localhost:3000
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Express Trust Proxy Hops (integer, default: 0)
# 0 = do not trust proxy headers; 1 = trust 1 reverse proxy hop (e.g., behind Nginx/Vercel/Render)
TRUST_PROXY_HOPS=0

# Authentication rate limiting (requests per IP per TTL in ms)
AUTH_RATE_LIMIT=30
AUTH_RATE_LIMIT_TTL=60000

# Server Port
PORT=3000

# Environment mode (development | production | test)
NODE_ENV=development
